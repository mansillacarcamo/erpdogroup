# ============================================================
#  .htaccess - Sistema DOGroup
#  Configuracion compatible con cualquier version PHP 8.x
#  La version PHP se controla desde cPanel (MultiPHP Manager)
# ============================================================

# Indicar archivo de inicio
DirectoryIndex index.html index.php

# No listar directorios
Options -Indexes

# ── BLOQUEAR archivos sensibles ────────────────────
<FilesMatch "\.(db|db-wal|db-shm|sqlite|sqlite3|env|log|sql|bak|backup|old|orig|swp|md|gitignore|deployignore|json|lock|phar|yml|yaml|toml|ini|conf)$">
  Require all denied
</FilesMatch>

# Permitir composer.json y manifest.json
<Files "composer.json">
  Require all granted
</Files>
<FilesMatch "^manifest.*\.json$">
  Require all granted
</FilesMatch>

# ── Forzar que index.html y index.php NO se cacheen ─
<FilesMatch "^index\.(php|html)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </IfModule>
</FilesMatch>

# ── Cache de assets estaticos ──────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png       "access plus 7 days"
  ExpiresByType image/jpeg      "access plus 7 days"
  ExpiresByType image/webp      "access plus 7 days"
  ExpiresByType image/svg+xml   "access plus 7 days"
  ExpiresByType text/css        "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
</IfModule>

# ── Headers de seguridad ─────────────────────────
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "same-origin"
</IfModule>

# ── Compresion gzip ─────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
